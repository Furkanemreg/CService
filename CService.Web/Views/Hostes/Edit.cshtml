@model CService.Core.Entities.Hostes
@{
    ViewData["Title"] = "Tanımlar > Kişi Tanımları > Hostesler > Düzenle";
}

<h2 class="mb-4">Hostes Düzenle</h2>
<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="col-md-5">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="Kod" class="form-label">Kod *</label>
        <input asp-for="Kod" class="form-control" required />
        <span asp-validation-for="Kod" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="AdSoyad" class="form-label">Ad Soyad *</label>
        <input asp-for="AdSoyad" class="form-control" required />
        <span asp-validation-for="AdSoyad" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Kaydet</button>
    <a asp-action="Index" class="btn btn-link">Vazgeç</a>
</form>

<partial name="_AuditInfo" model="Model" />