@model List<CService.Core.Entities.Bolge>
@{
    ViewData["Title"] = "Bölgeler";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Bölgeler</h2>
    <a asp-action="Create" class="btn btn-primary">Yeni Bölge</a>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Bölge Adı</th>
            <th>Bölge Kodu</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Ad</td>
                <td>@(item.Kod ?? "-")</td>
                <td class="text-end">
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Düzenle</a>
                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Silmek istediğine emin misin?');">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Sil</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>