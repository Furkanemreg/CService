@model List<CService.Core.Entities.AracSahibi>
@{
    ViewData["Title"] = "Araç Sahipleri";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Araç Sahipleri</h2>
    <a asp-action="Create" class="btn btn-primary">Yeni Araç Sahibi</a>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Kod</th>
            <th>Adı Soyadı</th>
            <th>TC Kimlik No</th>
            <th>Tel</th>
            <th>Durum</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Kod</td>
                <td>@item.TamAdi</td>
                <td>@item.TcKimlikNo</td>
                <td>@item.Tel</td>
                <td>@(item.IsActive ? "Aktif" : "Pasif")</td>
                <td class="text-end">
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Düzenle</a>
                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Silmek istediğine emin misin?');">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Sil</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>