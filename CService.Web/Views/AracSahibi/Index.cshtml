@model List<CService.Core.Entities.AracSahibi>
@{
    ViewData["Title"] = "Araç Sahipleri";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Araç Sahipleri</h2>
    <a asp-action="Create" class="btn btn-success">
        <svg class="btn-icon-inline"><use href="#icon-plus"></use></svg> Yeni Araç Sahibi
    </a>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Kod</th>
            <th>Ad Soyad</th>
            <th>TC Kimlik No</th>
            <th>Tel</th>
            <th>Durum</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Kod</td>
                <td>@item.TamAdi</td>
                <td>@item.TcKimlikNo</td>
                <td>@item.Tel</td>
                <td>@(item.IsActive ? "Aktif" : "Pasif")</td>
                <td class="text-end">
                    <button type="button" class="btn btn-sm btn-outline-secondary btn-icon" data-sahibi-araclar="@item.Id" data-sahibi-adi="@item.TamAdi">
                        <svg><use href="#icon-car"></use></svg> Araçlar
                    </button>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary btn-icon">
                        <svg><use href="#icon-edit"></use></svg> Düzenle
                    </a>
                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Silmek istediğine emin misin?');">
                        <button type="submit" class="btn btn-sm btn-outline-danger btn-icon">
                            <svg><use href="#icon-trash"></use></svg> Sil
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="modal fade" id="araclarModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <svg class="modal-title-icon"><use href="#icon-car"></use></svg>
                    <span id="araclarModalTitleText">Araçlar</span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body" id="araclarModalBody">
                <p class="text-muted mb-0">Yükleniyor...</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const araclarModalEl = document.getElementById('araclarModal');
        const araclarModal = new bootstrap.Modal(araclarModalEl);

        document.querySelectorAll('[data-sahibi-araclar]').forEach(function (btn) {
            btn.addEventListener('click', async function () {
                const aracSahibiId = btn.getAttribute('data-sahibi-araclar');
                const sahibiAdi = btn.getAttribute('data-sahibi-adi');
                document.getElementById('araclarModalTitleText').textContent = sahibiAdi + ' - Araçlar';
                document.getElementById('araclarModalBody').innerHTML = '<p class="text-muted mb-0">Yükleniyor...</p>';
                araclarModal.show();

                const response = await fetch('/AracSahibi/GetVehicles?aracSahibiId=' + aracSahibiId);
                document.getElementById('araclarModalBody').innerHTML = response.ok
                    ? await response.text()
                    : '<p class="text-danger mb-0">Araçlar yüklenemedi.</p>';
            });
        });
    </script>
}