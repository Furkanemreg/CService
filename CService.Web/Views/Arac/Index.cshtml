@using CService.Core.Extensions
@using CService.Core.Helpers
@model List<CService.Core.Entities.Arac>
@{
    ViewData["Title"] = "Araçlar";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Araçlar</h2>
    <a asp-action="Create" class="btn btn-success">
        <svg class="btn-icon-inline"><use href="#icon-plus"></use></svg> Yeni Araç
    </a>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Plaka</th>
            <th>Firma</th>
            <th>Sahibi</th>
            <th>Cinsi</th>
            <th>Markası</th>
            <th>Kapasite</th>
            <th>Durum</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Plaka</td>
                <td>@item.Firma?.Adi</td>
                <td>@item.AracSahibi?.TamAdi</td>
                <td>@item.AracCinsi?.Ad</td>
                <td>@item.AracMarka?.Ad</td>
                <td>@(item.Kapasite.HasValue ? item.Kapasite.Value : "-")</td>
                <td>@(item.IsActive ? "Aktif" : "Pasif")</td>
                <td class="text-end">
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary btn-icon">
                        <svg><use href="#icon-edit"></use></svg> Düzenle
                    </a>
                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Silmek istediğine emin misin?');">
                        <button type="submit" class="btn btn-sm btn-outline-danger btn-icon">
                            <svg><use href="#icon-trash"></use></svg> Sil
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>