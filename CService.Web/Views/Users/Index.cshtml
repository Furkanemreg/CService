@using System.Security.Claims
@model List<CService.Web.Models.Users.UserListItemViewModel>
@{
    ViewData["Title"] = "Yönetim > Kullanıcılar";
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Kullanıcılar</h2>
    <a asp-action="Create" class="btn btn-success">
        <svg class="btn-icon-inline"><use href="#icon-plus"></use></svg>
        Yeni Kullanıcı
    </a>
</div>

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<table class="table table-striped">
    <thead>
        <tr>
            <th>E-Posta Adresi</th>
            <th>Kullanıcı Rolü</th>
            <th>Durum</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model.OrderByDescending(x => x.Id == currentUserId))
        {
            var isSelf = user.Id == currentUserId;
            <tr>
                <td>
                    @user.Email @if (isSelf)
                    {
                        <span class="badge bg-secondary">Siz</span>
                    }
                </td>
                <td>
                    @foreach (var role in user.Roles)
                    {
                        var roleName = role switch
                        {
                            "Admin" => "Yönetici",
                            "Manager" => "Müdür",
                            "User" => "Kullanıcı",
                            _ => role
                        };

                        <span class="badge bg-light text-dark border me-1">
                            @roleName
                        </span>
                    }
                </td>
                <td>@(user.IsLocked ? "Kısıtlı" : "Aktif")</td>
                <td class="text-end">
                    <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-outline-primary btn-icon">
                        <svg><use href="#icon-edit"></use></svg> Düzenle
                    </a>
                    <a asp-action="ChangePassword" asp-route-id="@user.Id" class="btn btn-sm btn-outline-indigo btn-icon">
                        <svg><use href="#icon-key"></use></svg> Şifre Değiştir
                    </a>
                    @if (!isSelf)
                    {
                        <form asp-action="ToggleLock" asp-route-id="@user.Id" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-warning btn-icon">
                                <svg><use href="#@(user.IsLocked ? "icon-unlock" : "icon-lock")"></use></svg> @(user.IsLocked ? "Aktifleştir" : "Kısıtla")
                            </button>
                        </form>
                        <form asp-action="Delete" asp-route-id="@user.Id" method="post" class="d-inline" onsubmit="return confirm('Bu kullanıcıyı silmek istediğine emin misin? Geçmiş kayıtları korunur.');">
                            <button type="submit" class="btn btn-sm btn-outline-danger btn-icon">
                                <svg><use href="#icon-trash"></use></svg> Sil
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>