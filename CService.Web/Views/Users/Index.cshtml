@model List<CService.Web.Models.Users.UserListItemViewModel>
@{
    ViewData["Title"] = "Kullanıcılar";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Kullanıcılar</h2>
    <a asp-action="Create" class="btn btn-primary">Yeni Kullanıcı</a>
</div>

<table class="table table-striped">
    <thead>
        <tr><th>E-posta</th><th>Rol</th><th>Durum</th><th></th></tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.Email</td>
                <td>@string.Join(", ", user.Roles)</td>
                <td>@(user.IsLocked ? "Kısıtlı" : "Aktif")</td>
                <td class="text-end">
                    <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-outline-secondary">Düzenle</a>
                    <a asp-action="ChangePassword" asp-route-id="@user.Id" class="btn btn-sm btn-outline-secondary">Şifre Değiştir</a>
                    <form asp-action="ToggleLock" asp-route-id="@user.Id" method="post" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-outline-warning">@(user.IsLocked ? "Aktifleştir" : "Kısıtla")</button>
                    </form>
                    <form asp-action="Delete" asp-route-id="@user.Id" method="post" class="d-inline" onsubmit="return confirm('Bu kullanıcıyı silmek istediğine emin misin? Geçmiş kayıtları korunur.');">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Sil</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>