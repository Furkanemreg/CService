@model List<CService.Web.Models.GrupFirmalar.GrupFirmaListItemViewModel>
@{
    ViewData["Title"] = "Firmalar > Grup Firmalar";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Grup Firmalar</h2>
    <a asp-action="Create" class="btn btn-success">
        <svg class="btn-icon-inline"><use href="#icon-plus"></use></svg> Yeni Grup Firma
    </a>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Kod</th>
            <th>Ad</th>
            <th>Bölge</th>
            <th>Durum</th>
            <th>Üye Firmalar</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.GrupFirma.FirmaKodu</td>
                <td>@item.GrupFirma.Adi</td>
                <td>@item.GrupFirma.Bolge?.Ad</td>
                <td>@(item.GrupFirma.IsActive ? "Aktif" : "Pasif")</td>
                <td>@(item.UyeFirmalar.Count > 0 ? string.Join(", ", item.UyeFirmalar) : "—")</td>
                <td class="text-end">
                    <a asp-action="Edit" asp-route-id="@item.GrupFirma.Id" class="btn btn-sm btn-outline-primary btn-icon">
                        <svg><use href="#icon-edit"></use></svg> Düzenle
                    </a>
                    <form asp-action="Delete" asp-route-id="@item.GrupFirma.Id" method="post" class="d-inline" onsubmit="return confirm('Silmek istediğine emin misin?');">
                        <button type="submit" class="btn btn-sm btn-outline-danger btn-icon">
                            <svg><use href="#icon-trash"></use></svg> Sil
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>