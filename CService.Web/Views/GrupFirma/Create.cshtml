@model CService.Core.Entities.GrupFirma
@{
    ViewData["Title"] = "Yeni Grup Firma";
}

<h2 class="mb-4">Yeni Grup Firma</h2>
<form asp-action="Create" method="post" class="col-md-5">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="Ad" class="form-label">Ad *</label>
        <input asp-for="Ad" class="form-control" required />
        <span asp-validation-for="Ad" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Oluştur</button>
    <a asp-action="Index" class="btn btn-link">Vazgeç</a>
</form>