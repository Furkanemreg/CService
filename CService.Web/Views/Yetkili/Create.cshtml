@model CService.Core.Entities.Yetkili
@{
    ViewData["Title"] = "Tanımlar > Kişi Tanımları > Yetkililer > Yeni";
}

<h2 class="mb-4">Yeni Yetkili</h2>
<form asp-action="Create" method="post" class="col-md-5">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="Kod" class="form-label">Kod *</label>
        <input asp-for="Kod" class="form-control" required />
        <span asp-validation-for="Kod" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="AdSoyad" class="form-label">Ad Soyad *</label>
        <input asp-for="AdSoyad" class="form-control" required />
        <span asp-validation-for="AdSoyad" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Oluştur</button>
    <a asp-action="Index" class="btn btn-link">Vazgeç</a>
</form>