@model List<CService.Core.Entities.Firma>
@{
    ViewData["Title"] = "Firmalar > Firma Listesi";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Firmalar</h2>
    <a asp-action="Create" class="btn btn-success">
        <svg class="btn-icon-inline"><use href="#icon-plus"></use></svg> Yeni Firma
    </a>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Kod</th>
            <th>Firma Adı</th>
            <th>VKN / TCKN</th>
            <th>Tür</th>
            <th>Bölge</th>
            <th>Durum</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.FirmaKodu</td>
                <td>@item.Adi</td>
                <td>@(item.VergiNo ?? "-")</td>
                <td>
                    @if (item.VergiNo?.Length == 11)
                    {
                        <span class="firma-type-badge firma-type-person">
                            <i class="fa fa-user"></i>
                            Şahıs
                        </span>
                    }
                    else if (item.VergiNo?.Length == 10)
                    {
                        <span class="firma-type-badge firma-type-company">
                            <i class="fa fa-building"></i>
                            Tüzel
                        </span>
                    }
                    else
                    {
                        <span class="firma-type-badge firma-type-unknown">
                            <i class="fa fa-question"></i>
                            -
                        </span>
                    }
                </td>
                <td>@(item.Bolge?.Ad ?? "-")</td>
                <td>@(item.IsActive ? "Aktif" : "Pasif")</td>
                <td class="text-end">
                    <button type="button" class="btn btn-sm btn-outline-secondary btn-icon" data-firma-araclar="@item.Id" data-firma-adi="@item.Adi">
                        <svg><use href="#icon-car"></use></svg> Araçlar
                    </button>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary btn-icon">
                        <svg><use href="#icon-edit"></use></svg> Düzenle
                    </a>
                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Silmek istediğine emin misin?');">
                        <button type="submit" class="btn btn-sm btn-outline-danger btn-icon">
                            <svg><use href="#icon-trash"></use></svg> Sil
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="modal fade" id="araclarModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <svg class="modal-title-icon"><use href="#icon-car"></use></svg>
                    <span id="araclarModalTitleText">Araçlar</span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body">
                <div class="search-select mb-3">
                    <input type="text" class="form-control search-select-input" id="araclarModalSearch" placeholder="Plaka veya araç sahibi giriniz..." autocomplete="off" />
                    <span class="search-select-icon">
                        <svg><use href="#icon-search"></use></svg>
                    </span>
                </div>
                <div id="araclarModalResults">
                    <p class="text-muted mb-0">Yükleniyor...</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const araclarModalEl = document.getElementById('araclarModal');
        const araclarModal = new bootstrap.Modal(araclarModalEl);
        const araclarModalSearch = document.getElementById('araclarModalSearch');
        const araclarModalResults = document.getElementById('araclarModalResults');
        let currentFirmaId = null;
        let searchTimer = null;

        async function loadVehicles(firmaId, q) {
            araclarModalResults.innerHTML = '<p class="text-muted mb-0">Yükleniyor...</p>';

            const url = '/Firma/GetVehicles?firmaId=' + firmaId + (q ? '&q=' + encodeURIComponent(q) : '');
            const response = await fetch(url);
            araclarModalResults.innerHTML = response.ok
                ? await response.text()
                : '<p class="text-danger mb-0">Araçlar yüklenemedi.</p>';
        }

        document.querySelectorAll('[data-firma-araclar]').forEach(function (btn) {
            btn.addEventListener('click', function () {
                currentFirmaId = btn.getAttribute('data-firma-araclar');
                const firmaAdi = btn.getAttribute('data-firma-adi');
                document.getElementById('araclarModalTitleText').textContent = firmaAdi + ' - Araçlar';
                araclarModalSearch.value = '';
                araclarModal.show();
                loadVehicles(currentFirmaId, '');
            });
        });

        araclarModalSearch.addEventListener('input', function () {
            clearTimeout(searchTimer);
            searchTimer = setTimeout(function () {
                if (currentFirmaId) loadVehicles(currentFirmaId, araclarModalSearch.value.trim());
            }, 250);
        });
    </script>
}