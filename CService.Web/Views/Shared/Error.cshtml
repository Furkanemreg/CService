@model CService.Web.Models.ErrorViewModel
@{
    ViewData["Title"] = "Hata";
}

<div class="error-page">
    <div class="error-card">
        <div class="error-icon error-icon-danger">
            <svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="9" />
                <path d="M12 8v5" />
                <circle cx="12" cy="16" r="0.5" fill="currentColor" />
            </svg>
        </div>

        <h2 class="error-title">Bir hata oluştu</h2>
        <p class="error-subtitle">İşlem tamamlanamadı. Aşağıdaki bilgileri sistem yöneticinizle paylaşabilirsiniz.</p>

        <div class="error-meta">
            @if (Model.ShowRequestId)
            {
                <span class="error-chip"><strong>Request Id:</strong> @Model.RequestId</span>
            }
            @if (!string.IsNullOrEmpty(Model.Path))
            {
                <span class="error-chip"><strong>Yol:</strong> @Model.Path</span>
            }
        </div>

        @if (!string.IsNullOrEmpty(Model.ExceptionMessage))
        {
            <div class="error-message">@Model.ExceptionMessage</div>
        }

        @if (!string.IsNullOrEmpty(Model.StackTrace))
        {
            <details class="error-details">
                <summary>Teknik Detayları Göster</summary>
                <pre>@Model.StackTrace</pre>
            </details>
        }

        <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-4">Ana Sayfaya Dön</a>
    </div>
</div>