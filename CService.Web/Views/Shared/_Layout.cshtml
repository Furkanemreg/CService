@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    bool IsActive(string controller) => string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase);
    bool IsInGroup(params string[] controllers) => controllers.Any(IsActive);

    var tanimlarOpen = IsInGroup("Bolge", "BankaHesabi");
    var cariOpen = IsInGroup("Firma", "GrupFirma");
    var firmalarOpen = IsInGroup("Firma", "GrupFirma");
    var araclarOpen = IsInGroup("Arac", "AracSahibi");
    var yonetimOpen = IsInGroup("Users", "Logs");
    var isChangePasswordPage = IsActive("Account") && ViewContext.RouteData.Values["action"]?.ToString() == "ChangePassword";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CService Puantaj</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/errors.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CService.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <svg style="display:none" aria-hidden="true">
        <symbol id="icon-home" viewBox="0 0 24 24"><path d="M3 11.5 12 4l9 7.5" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round" /><path d="M5 10v9a1 1 0 0 0 1 1h4v-6h4v6h4a1 1 0 0 0 1-1v-9" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round" /></symbol>
        <symbol id="icon-map" viewBox="0 0 24 24"><path d="M9 4 4 6v14l5-2 6 2 5-2V4l-5 2-6-2Z" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linejoin="round" /><path d="M9 4v14M15 6v14" stroke="currentColor" stroke-width="1.6" /></symbol>
        <symbol id="icon-group" viewBox="0 0 24 24"><circle cx="9" cy="8" r="3" stroke="currentColor" stroke-width="1.6" fill="none" /><circle cx="17" cy="9" r="2.4" stroke="currentColor" stroke-width="1.6" fill="none" /><path d="M3 20c0-3 2.7-5 6-5s6 2 6 5M14 20c0-2.2 1.8-4 5-4" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" /></symbol>
        <symbol id="icon-bank" viewBox="0 0 24 24"><path d="M4 10 12 4l8 6M5 10v9h14v-9M9 13v4M12 13v4M15 13v4" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round" /></symbol>
        <symbol id="icon-building" viewBox="0 0 24 24"><rect x="5" y="3" width="14" height="18" rx="1" stroke="currentColor" stroke-width="1.6" fill="none" /><path d="M9 7h1M14 7h1M9 11h1M14 11h1M9 15h1M14 15h1" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></symbol>
        <symbol id="icon-users" viewBox="0 0 24 24"><circle cx="9" cy="8" r="3" stroke="currentColor" stroke-width="1.6" fill="none" /><path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" /><path d="M15 8a3 3 0 1 1 0 6M17 20c0-2.5-1.4-4.6-3.5-5.6" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" /></symbol>
        <symbol id="icon-log" viewBox="0 0 24 24"><path d="M6 3h9l4 4v14H6Z" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linejoin="round" /><path d="M9 12h6M9 16h6M9 8h3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></symbol>
        <symbol id="icon-key" viewBox="0 0 24 24"><circle cx="8" cy="15" r="3.5" stroke="currentColor" stroke-width="1.6" fill="none" /><path d="M10.5 12.5 19 4M16 7l2 2M13.3 9.7l2 2" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" /></symbol>
        <symbol id="icon-logout" viewBox="0 0 24 24"><path d="M9 4H5a1 1 0 0 0-1 1v14a1 1 0 0 0 1 1h4M16 8l4 4-4 4M20 12H9" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round" /></symbol>
        <symbol id="icon-chevron" viewBox="0 0 24 24"><path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round" stroke-linejoin="round" /></symbol>
        <symbol id="icon-list" viewBox="0 0 24 24"><path d="M8 6h12M8 12h12M8 18h12M4 6h.01M4 12h.01M4 18h.01" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round" /></symbol>
        <symbol id="icon-folder" viewBox="0 0 24 24"><path d="M4 7a1 1 0 0 1 1-1h4l2 2h8a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7Z" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linejoin="round" /></symbol>
        <symbol id="icon-settings" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.6" fill="none" /><path d="M19.4 13.5a7.97 7.97 0 0 0 0-3l1.6-1.2-1.5-2.6-1.9.6a8.1 8.1 0 0 0-2.6-1.5L14.5 3h-3l-.5 2.8a8.1 8.1 0 0 0-2.6 1.5l-1.9-.6-1.5 2.6L6 10.5a7.97 7.97 0 0 0 0 3l-1.6 1.2 1.5 2.6 1.9-.6c.77.66 1.65 1.18 2.6 1.5L11 21h3l.5-2.8c.95-.32 1.83-.84 2.6-1.5l1.9.6 1.5-2.6-1.6-1.2Z" stroke="currentColor" stroke-width="1.4" fill="none" stroke-linejoin="round" /></symbol>
        <symbol id="icon-wallet" viewBox="0 0 24 24"><rect x="3" y="6" width="18" height="13" rx="2" stroke="currentColor" stroke-width="1.6" fill="none" /><path d="M3 10h18" stroke="currentColor" stroke-width="1.6" /><circle cx="17" cy="14" r="1" fill="currentColor" /></symbol>
    </svg>

    <div class="app-shell">
        <aside class="sidebar" id="sidebar">
            <div class="sidebar-brand">
                <span class="brand-mark">CS</span>
                <span class="brand-text">CService</span>
            </div>

            <nav class="sidebar-nav">
                <a class="nav-link @(IsActive("Home") ? "active" : "")" asp-controller="Home" asp-action="Index">
                    <svg><use href="#icon-home"></use></svg>
                    <span>Ana Sayfa</span>
                </a>

                @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                {
                    <div class="nav-group">
                        <button class="nav-section-toggle" type="button" data-toggle-target="navTanimlar" aria-expanded="@(tanimlarOpen ? "true" : "false")">
                            <span>Tanımlar</span>
                            <svg class="chevron"><use href="#icon-chevron"></use></svg>
                        </button>
                        <div class="collapse-panel @(tanimlarOpen ? "open" : "")" id="navTanimlar">
                            <a class="nav-link @(IsActive("Bolge") ? "active" : "")" asp-controller="Bolge" asp-action="Index">
                                <svg><use href="#icon-map"></use></svg>
                                <span>Bölgeler</span>
                            </a>
                            <a class="nav-link @(IsActive("BankaHesabi") ? "active" : "")" asp-controller="BankaHesabi" asp-action="Index">
                                <svg><use href="#icon-bank"></use></svg>
                                <span>Banka Hesapları</span>
                            </a>
                            <a class="nav-link @(IsActive("OdemeGrubu") ? "active" : "")" asp-controller="OdemeGrubu" asp-action="Index">
                                <svg><use href="#icon-wallet"></use></svg>
                                <span>Ödeme Grupları</span>
                            </a>
                        </div>
                    </div>

                    <div class="nav-group">
                        <button class="nav-section-toggle" type="button" data-toggle-target="navCari" aria-expanded="@(cariOpen ? "true" : "false")">
                            <span>Cari Listeler</span>
                            <svg class="chevron"><use href="#icon-chevron"></use></svg>
                        </button>
                        <div class="collapse-panel @(cariOpen ? "open" : "")" id="navCari">
                            <button class="nav-sublink-toggle @(IsActive("Firma") ? "active" : "")" type="button" data-toggle-target="navFirmalar" aria-expanded="@(firmalarOpen ? "true" : "false")">
                                <svg><use href="#icon-building"></use></svg>
                                <span>Firmalar</span>
                                <svg class="chevron"><use href="#icon-chevron"></use></svg>
                            </button>
                            <div class="collapse-panel nav-sub @(firmalarOpen ? "open" : "")" id="navFirmalar">
                                <a class="nav-link nav-sub-link @(IsActive("Firma") ? "active" : "")" asp-controller="Firma" asp-action="Index">
                                    <span>Firma Listesi</span>
                                </a>
                                <a class="nav-link nav-sub-link @(IsActive("GrupFirma") ? "active" : "")" asp-controller="GrupFirma" asp-action="Index">
                                    <span>Grup Firmalar</span>
                                </a>
                            </div>

                            <div class="nav-group">
                                <button class="nav-section-toggle" type="button" data-toggle-target="navAraclar" aria-expanded="@(araclarOpen ? "true" : "false")">
                                    <svg><use href="#icon-building"></use></svg>
                                    <span>Araçlar</span>
                                    <svg class="chevron"><use href="#icon-chevron"></use></svg>
                                </button>
                                <div class="collapse-panel @(IsInGroup("Arac", "AracSahibi") ? "open" : "")" id="navAraclar">
                                    <a class="nav-link @(IsActive("Arac") ? "active" : "")" asp-controller="Arac" asp-action="Index">
                                        <span>Araç Listesi</span>
                                    </a>
                                    <a class="nav-link @(IsActive("AracSahibi") ? "active" : "")" asp-controller="AracSahibi" asp-action="Index">
                                        <span>Araç Sahipleri</span>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }

                @if (User.IsInRole("Admin"))
                {
                    <div class="nav-group">
                        <button class="nav-section-toggle" type="button" data-toggle-target="navYonetim" aria-expanded="@(yonetimOpen ? "true" : "false")">
                            <span>Yönetim</span>
                            <svg class="chevron"><use href="#icon-chevron"></use></svg>
                        </button>
                        <div class="collapse-panel @(yonetimOpen ? "open" : "")" id="navYonetim">
                            <a class="nav-link @(IsActive("Users") ? "active" : "")" asp-controller="Users" asp-action="Index">
                                <svg><use href="#icon-users"></use></svg>
                                <span>Kullanıcılar</span>
                            </a>
                            <a class="nav-link @(IsActive("Logs") ? "active" : "")" asp-controller="Logs" asp-action="Index">
                                <svg><use href="#icon-log"></use></svg>
                                <span>Loglar</span>
                            </a>
                        </div>
                    </div>
                }
            </nav>

            <div class="sidebar-footer">
                @if (User.Identity is { IsAuthenticated: true })
                {
                    <button class="user-chip-toggle" type="button" data-toggle-target="userMenu" aria-expanded="@(isChangePasswordPage ? "true" : "false")">
                        <span class="status-dot" aria-hidden="true"></span>
                        <span class="user-email">@User.Identity.Name</span>
                        <svg class="chevron"><use href="#icon-chevron"></use></svg>
                    </button>
                    <div class="collapse-panel @(isChangePasswordPage ? "open" : "")" id="userMenu">
                        <a class="nav-link @(isChangePasswordPage ? "active" : "")" asp-controller="Account" asp-action="ChangePassword">
                            <svg><use href="#icon-key"></use></svg>
                            <span>Şifremi Değiştir</span>
                        </a>
                        <form asp-controller="Account" asp-action="Logout" method="post">
                            <button type="submit" class="nav-link btn-logout">
                                <svg><use href="#icon-logout"></use></svg>
                                <span>Çıkış Yap</span>
                            </button>
                        </form>
                    </div>
                }
                else
                {
                    <a class="nav-link" asp-controller="Account" asp-action="Login">
                        <svg><use href="#icon-key"></use></svg>
                        <span>Giriş Yap</span>
                    </a>
                }
            </div>
        </aside>

        <div class="app-main">
            <header class="topbar">
                <button class="sidebar-toggle" id="sidebarToggle" type="button" aria-label="Menüyü aç/kapat">
                    <span></span><span></span><span></span>
                </button>
                <h1 class="page-title">@ViewData["Title"]</h1>
            </header>

            <main class="content">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        document.getElementById('sidebarToggle')?.addEventListener('click', function () {
            document.getElementById('sidebar').classList.toggle('open');
        });

        document.querySelectorAll('[data-toggle-target]').forEach(function (btn) {
            btn.addEventListener('click', function () {
                const target = document.getElementById(btn.getAttribute('data-toggle-target'));
                if (!target) return;

                const isOpen = target.classList.toggle('open');
                btn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>