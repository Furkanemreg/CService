@model CService.Core.Entities.OdemeGrubu
@{
    ViewData["Title"] = "Ödeme Grubu Düzenle";
}

<h2 class="mb-4">Ödeme Grubu Düzenle</h2>
<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="col-md-5">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="Kod" class="form-label">Ödeme Grubu Kodu *</label>
        <input asp-for="Kod" class="form-control" required />
    </div>
    <div class="mb-3">
        <label asp-for="Ad" class="form-label">Ödeme Grubu Adı *</label>
        <input asp-for="Ad" class="form-control" required />
    </div>
    <button type="submit" class="btn btn-primary">Kaydet</button>
    <a asp-action="Index" class="btn btn-link">Vazgeç</a>
</form>